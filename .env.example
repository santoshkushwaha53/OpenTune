# OpenTune local development environment
# Copy to `.env` and fill in values. Never commit `.env`.

# --- API ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://opentune:opentune@localhost:5432/opentune?schema=public

# JWT placeholders (used from Phase 4). Generate strong secrets before any real auth.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d

# CORS — comma-separated origins. Empty means reflect request origin in development only.
# Empty = reflect request origin in development; set explicit origins in production.
CORS_ORIGIN=

# In-memory rate limit (Phase 3). Redis is not required.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# --- Audius official API. Leave empty to keep the provider disabled. ---
# https://docs.audius.co/api
AUDIUS_API_KEY=

# --- Jamendo official API (Phase 6). Leave empty to keep the provider disabled. ---
# https://developer.jamendo.com/v3.0
JAMENDO_CLIENT_ID=

# Operator token for catalog sync and health writes (Phase 18). Min 16 characters.
# Send as header: x-opentune-operator
OPERATOR_TOKEN=

# Production host: copy `.env.production.example` and see docs/DEPLOY.md.
# Never set NODE_ENV=production with the placeholder JWT values above.
