# Production environment for docker compose -f docker-compose.prod.yml
# Copy to `.env` on the host. Never commit the filled file.

NODE_ENV=production
API_PORT=3000
LOG_LEVEL=info

# Strong database password (hex, so it is safe inside DATABASE_URL). PostgreSQL is not published to the host.
POSTGRES_PASSWORD=

# Generate with: openssl rand -hex 32
# Must be ≥32 characters, unique, and not a documented placeholder.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d

# Native Flutter does not need CORS. Set only if a browser client exists.
CORS_ORIGIN=

# https://docs.audius.co/api — leave empty to keep Audius disabled.
AUDIUS_API_KEY=

# https://developer.jamendo.com/v3.0 — leave empty to keep Jamendo disabled.
JAMENDO_CLIENT_ID=

# https://developers.google.com/youtube/v3 — leave empty to keep YouTube disabled.
YOUTUBE_API_KEY=

# https://archive.org/developers/search.html — set false to disable Internet Archive.
INTERNET_ARCHIVE_ENABLED=true

# Operator catalog sync / health writes. Min 16 characters. Empty disables those routes.
OPERATOR_TOKEN=
